{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Agent|Task|Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ui-workflow-guard.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(gh project:*)",
      "Bash(gh pr:*)",
      "Bash(gh label:*)",
      "Bash(gh run:*)",
      "Bash(openspec:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx playwright:*)",
      "Bash(npx vitest:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Read(./.env)"
    ]
  }
}
