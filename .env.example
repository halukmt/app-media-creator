# app-media-creator environment
# Copy to .env (never commit .env). Every variable is optional.

# Optional: enables the "Generate" button in the UI for AI copy (headlines, store texts).
# Without a key, AI work runs through the bundled Claude Code skill `amc-copy` in your editor
# using your own Claude Code login. The key is billed to its owner.
ANTHROPIC_API_KEY=

# Optional: port of the local UI server (default 4790).
AMC_PORT=4790

# Optional: path to an ffmpeg binary if it is not on PATH (needed for video features).
FFMPEG_PATH=

# Optional: path to ffprobe (measures videos). Defaults to ffprobe next to FFMPEG_PATH, then ffprobe on PATH.
FFPROBE_PATH=
